rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Test connection endpoint for connectivity check
    match /test/{testId} {
      allow read: if true;
    }

    // User progress and profile synchronization - strictly owner-only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow subcollections if any (e.g., quiz history, activity logs)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
